<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system launch screen: the app icon, centred, until the first Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/app_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/splash_icon_dark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_launch_background</item>
    </style>
</resources>
